			<AfterSimulationRunCode><![CDATA[double hasselbachQ_max = root.statistics_Hasselbach1Q.max() + root.statistics_Hasselbach2Q.max();
System.out.println("The max Q length for Hasselbach is: " + hasselbachQ_max);


double hasselbachQ_mean = root.statistics_Hasselbach1Q.mean() + root.statistics_Hasselbach2Q.mean();
System.out.println("The min Q length for Hasselbach is: " + hasselbachQ_mean);

double throughput = root.carDispose5.count() + root.carDispose.count() + root.carDispose2.count()+root.carDispose4.count();
System.out.println("The Total Throughput is: " + throughput);

System.out.println("ADIOS");]]></AfterSimulationRunCode>
